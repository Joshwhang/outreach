# copy to .env and fill in
# LLM backend: 'claude-code' uses your Claude subscription via the Claude Code CLI (run `claude auth login` once).
# 'api' uses a pay-per-token key. 'auto' picks api only if ANTHROPIC_API_KEY is set.
LLM_BACKEND=auto
# ANTHROPIC_API_KEY=sk-ant-...
# Model per job. Aliases: opus (best, uses the most quota), sonnet (fast, cheap), haiku (cheapest).
# Drafts default to sonnet; priority-1 (Claremont alumni) drafts get opus since those matter most.
MODEL_RESUME=sonnet
MODEL_DRAFT=sonnet
MODEL_DRAFT_P1=opus
# optional - Apollo people search (paid plan needed for API search)
APOLLO_API_KEY=
# optional - Hunter.io email verification (free tier: 50 verifications/mo)
HUNTER_API_KEY=
# shown in the email signature and as Reply-To - keep this your .edu
SENDER_EMAIL=jowhang@pitzer.edu
# From header; blank = whichever Gmail account you authorized.
# Set to the .edu only after adding it as a verified "Send mail as" alias in Gmail settings.
SENDER_FROM=
# phone shown in the email signature (optional)
SENDER_PHONE=
# override default paths if needed
# RESUME_PDF=../resume.pdf
# TRACKER_XLSX=../Internship Tracker Summer 2027.xlsx
# CONTACTS_XLSX=../Outreach Contacts.xlsx
